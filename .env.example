# Copy relevant sections into web/.env.local, android/local.properties (or
# gradle.properties), and Supabase Edge Function secrets. Never commit the
# filled-in versions — see .gitignore.

# ---------------------------------------------------------------------------
# WEB (web/.env.local) — safe to expose in the browser bundle (anon key is
# public-by-design and is only usable subject to Row Level Security).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# ANDROID (android/local.properties or a gradle.properties not committed) —
# same anon key as web, scoped by RLS. Never put the service role key here.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — Supabase Edge Function secrets (`supabase secrets set`).
# MUST NEVER be embedded in the Android or web client bundles.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Google OAuth (configured in Supabase Auth providers + Google Cloud Console)
# Not consumed directly as env vars by the clients (Supabase handles the
# OAuth redirect), but documented here so the values live in one place.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
