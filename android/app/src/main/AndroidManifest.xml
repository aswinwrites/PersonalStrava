<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- GPS recording (spec section 12) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background location: only needed while an activity is being recorded
         and the screen is off / app is backgrounded (spec section 13).
         Requested progressively — see PermissionFlow.kt — never bundled
         into the first-run permission prompt. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Health Connect: steps ingestion (spec section 11) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Notifications for the foreground-service recording notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:name=".PersonalStravaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PersonalStrava"
        android:supportsRtl="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PersonalStrava">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth redirect deep link: personalstrava://auth-callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="personalstrava" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Records GPS in the background for cycling/motorcycling activities
             (spec sections 12-13). Started/stopped explicitly by the user;
             never auto-starts. -->
        <service
            android:name=".record.ActivityRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Periodic Health Connect step sync + sync-queue flush; see
             docs/sync.md for the WorkManager scheduling policy. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge" />

    </application>
</manifest>
